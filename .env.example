# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). Nunca commite o .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Só no servidor: usada pelo administrador para cadastrar usuários.
SUPABASE_SERVICE_ROLE_KEY=
# Endereço do site (usado no link de "Esqueci minha senha")
NEXT_PUBLIC_SITE_URL=http://localhost:3000
